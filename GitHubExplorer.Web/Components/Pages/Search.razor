@page "/"
@using GitHubExplorer.Web.Components.Shared
@inject IGitHubExplorerApiClient Api
@inject ToastService Toasts
@inject SearchState State
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Cerca · GitHub Explorer</PageTitle>

<h1>Cerca repository</h1>

<div class="search-bar">
    <input @ref="searchInput" id="repo-search" @bind="State.Query" @bind:event="oninput" @onkeyup="OnKeyUp"
           placeholder="Cerca su GitHub… (es. blazor)" aria-label="Cerca su GitHub" />
    <select @bind="State.Sort" @bind:after="OnSortChanged" class="sort-select">
        <option value="">Più rilevanti</option>
        <option value="stars">Più stelle</option>
        <option value="updated">Aggiornati di recente</option>
        <option value="forks">Più fork</option>
    </select>
    <button @onclick="NewSearch" disabled="@loading">Cerca</button>
</div>
<p class="search-hint">
    Puoi combinare i qualificatori di GitHub in un'unica query, es. <code>blazor in:name language:c# stars:&gt;1000</code>.
</p>

@if (loading)
{
    <Spinner />
}
else if (error is not null)
{
    <div class="error-state">
        <p class="error">@error</p>
        <button @onclick="Load" disabled="@loading">Riprova</button>
    </div>
}
else if (State.Results is not null)
{
    @if (State.Results.Items.Count == 0)
    {
        <p>Nessun risultato per «@State.LastQuery».</p>
    }
    else
    {
        <div class="results-head">
            <h2 class="results-title">Risultati per «<span class="q">@State.LastQuery</span>»</h2>
            <div class="results-toolbar">
                <button class="view-btn @(State.GridView ? null : "active")" @onclick="() => SetView(false)" title="Lista" aria-label="Vista lista" aria-pressed="@(!State.GridView)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" />
                        <line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" />
                    </svg>
                </button>
                <button class="view-btn @(State.GridView ? "active" : null)" @onclick="() => SetView(true)" title="Griglia" aria-label="Vista griglia" aria-pressed="@State.GridView">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" />
                    </svg>
                </button>
            </div>
        </div>

        <div class="@(State.GridView ? "results-grid" : "results-list")">
            @foreach (var repo in State.Results.Items)
            {
                var isFavorite = _favoriteIds.Contains(repo.GithubId);
                <RepositoryCard Owner="@repo.Owner" Name="@repo.Name" HtmlUrl="@repo.HtmlUrl"
                          Description="@repo.Description" Stars="repo.Stars"
                          Language="@repo.Language" Forks="repo.Forks" Meta="@Aggiornato(repo.UpdatedAt)">
                    <button class="@(isFavorite ? "added" : null)"
                            @onclick="() => Add(repo)"
                            disabled="@(isFavorite || _adding.Contains(repo.GithubId))">
                        @(isFavorite ? "✓ Nei preferiti" : "★ Aggiungi ai preferiti")
                    </button>
                </RepositoryCard>
            }
        </div>

        <div class="pager">
            <button @onclick="() => GoToPage(State.Page - 1)" disabled="@(State.Page <= 1 || loading)">← Prec</button>
            <span class="pager-info">Pagina @State.Page di @TotalPages · @Risultati(State.Results.TotalCount)</span>
            <button @onclick="() => GoToPage(State.Page + 1)" disabled="@(State.Page >= TotalPages || loading)">Succ →</button>
        </div>
    }
}
else
{
    <div class="empty-state">
        <svg class="empty-art" width="150" height="120" viewBox="0 0 150 120" fill="none" aria-hidden="true">
            <rect x="18" y="24" width="84" height="14" rx="4" class="art-soft" />
            <rect x="18" y="46" width="62" height="14" rx="4" class="art-soft" />
            <rect x="18" y="68" width="72" height="14" rx="4" class="art-soft" />
            <circle cx="104" cy="82" r="22" class="art-line" />
            <line x1="120" y1="98" x2="136" y2="114" class="art-line" />
        </svg>
        <h2>Esplora i repository pubblici di GitHub</h2>
        <p>Cerca per nome, linguaggio o argomento. Combina i qualificatori per affinare i risultati.</p>
        <div class="example-chips">
            <button class="chip" @onclick='() => RunExample("blazor in:name")'>blazor in:name</button>
            <button class="chip" @onclick='() => RunExample("language:c# stars:>1000")'>language:c# stars:&gt;1000</button>
            <button class="chip" @onclick='() => RunExample("webassembly")'>webassembly</button>
        </div>
    </div>
}

@code {
    private const int PerPage = 10;
    private bool loading;
    private string? error;
    private ElementReference searchInput;

    private readonly CancellationTokenSource _cts = new();
    private readonly HashSet<long> _adding = new();
    private readonly HashSet<long> _favoriteIds = new();

    private int TotalPages => State.Results is null ? 0 : (int)Math.Ceiling(State.Results.TotalCount / (double)PerPage);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var favorites = await Api.GetFavoritesAsync(_cts.Token);
            foreach (var f in favorites)
                _favoriteIds.Add(f.GithubId);
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await searchInput.FocusAsync();

        var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "repo-view");
        if (saved is "grid" or "list")
        {
            State.GridView = saved == "grid";
            StateHasChanged();
        }
    }

    private async Task SetView(bool grid)
    {
        State.GridView = grid;
        await JS.InvokeVoidAsync("localStorage.setItem", "repo-view", grid ? "grid" : "list");
    }

    private async Task NewSearch()
    {
        if (string.IsNullOrWhiteSpace(State.Query)) return;
        State.LastQuery = State.Query;
        State.Page = 1;
        await Load();
    }

    private async Task RunExample(string example)
    {
        State.Query = example;
        await NewSearch();
    }

    private static string Risultati(int n) => n == 1 ? "1 risultato" : $"{n:N0} risultati";

    private static string Aggiornato(DateTime d)
    {
        var days = (DateTime.UtcNow - d).TotalDays;
        return days < 1 ? "aggiornato oggi"
             : days < 2 ? "aggiornato ieri"
             : days < 30 ? $"aggiornato {(int)days} giorni fa"
             : $"aggiornato il {d:d MMM yyyy}";
    }

    private async Task GoToPage(int target)
    {
        State.Page = target;
        await Load();
    }

    private async Task OnSortChanged()
    {
        if (string.IsNullOrWhiteSpace(State.LastQuery)) return;
        State.Page = 1;
        await Load();
    }

    private async Task Load()
    {
        loading = true; error = null;
        try
        {
            State.Results = await Api.SearchAsync(State.LastQuery, State.Page, PerPage, State.Sort, _cts.Token);
        }
        catch
        {
            error = "Errore durante la ricerca. Riprova.";
            State.Results = null;
        }
        finally { loading = false; }
    }

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await NewSearch();
    }

    private async Task Add(RepositoryDto repo)
    {
        _adding.Add(repo.GithubId);
        try
        {
            var req = new CreateFavoriteRequest(
                repo.GithubId, repo.Name, repo.FullName, repo.Owner,
                repo.HtmlUrl, repo.Description, repo.Stars, Note: null);
            var added = await Api.AddFavoriteAsync(req, _cts.Token);
            _favoriteIds.Add(repo.GithubId);
            if (added)
                Toasts.ShowSuccess($"«{repo.FullName}» aggiunto ai preferiti.");
            else
                Toasts.ShowInfo($"«{repo.FullName}» è già nei preferiti.");
        }
        catch
        {
            Toasts.ShowError("Impossibile aggiungere il preferito. Riprova.");
        }
        finally
        {
            _adding.Remove(repo.GithubId);
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
