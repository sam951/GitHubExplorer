@page "/"
@using GitHubExplorer.Web.Components.Shared
@inject IGitHubExplorerApiClient Api
@inject ToastService Toasts

<h1>Cerca repository</h1>

<div class="search-bar">
    <input @bind="query" @bind:event="oninput" @onkeyup="OnKeyUp"
           placeholder="Cerca su GitHub… (es. blazor)" />
    <button @onclick="NewSearch" disabled="@loading">Cerca</button>
</div>

@if (loading)
{
    <Spinner />
}
else if (error is not null)
{
    <p class="error">@error</p>
}
else if (results is not null)
{
    @if (results.Items.Count == 0)
    {
        <p>Nessun risultato per «@lastQuery».</p>
    }
    else
    {
        @foreach (var repo in results.Items)
        {
            <RepositoryCard Owner="@repo.Owner" Name="@repo.Name" HtmlUrl="@repo.HtmlUrl"
                      Description="@repo.Description" Stars="repo.Stars">
                <button @onclick="() => Add(repo)">★ Aggiungi ai preferiti</button>
            </RepositoryCard>
        }

        <div class="pager">
            <button @onclick="() => GoToPage(selectedPage - 1)" disabled="@(selectedPage <= 1 || loading)">← Prec</button>
            <span class="pager-info">Pagina @selectedPage di @TotalPages · @results.TotalCount risultati</span>
            <button @onclick="() => GoToPage(selectedPage + 1)" disabled="@(selectedPage >= TotalPages || loading)">Succ →</button>
        </div>
    }
}

@code {
    private const int PerPage = 10;
    private string query = "";
    private string lastQuery = "";
    private PagedResult<RepositoryDto>? results;
    private bool loading;
    private string? error;
    private int selectedPage = 1;

    private int TotalPages => results is null ? 0 : (int)Math.Ceiling(results.TotalCount / (double)PerPage);

    private async Task NewSearch()
    {
        if (string.IsNullOrWhiteSpace(query)) return;
        lastQuery = query;
        selectedPage = 1;
        await Load();
    }

    private async Task GoToPage(int target)
    {
        selectedPage = target;
        await Load();
    }

    private async Task Load()
    {
        loading = true; error = null;
        try
        {
            results = await Api.SearchAsync(lastQuery, selectedPage, PerPage, CancellationToken.None);
        }
        catch
        {
            error = "Errore durante la ricerca. Riprova.";
            results = null;
        }
        finally { loading = false; }
    }

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await NewSearch();
    }

    private async Task Add(RepositoryDto repo)
    {
        var req = new CreateFavoriteRequest(
            repo.GithubId, repo.Name, repo.FullName, repo.Owner,
            repo.HtmlUrl, repo.Description, repo.Stars, Note: null);
        try
        {
            var added = await Api.AddFavoriteAsync(req, CancellationToken.None);
            if (added)
                Toasts.ShowSuccess($"«{repo.FullName}» aggiunto ai preferiti.");
            else
                Toasts.ShowInfo($"«{repo.FullName}» è già nei preferiti.");
        }
        catch
        {
            Toasts.ShowError("Impossibile aggiungere il preferito. Riprova.");
        }
    }
}