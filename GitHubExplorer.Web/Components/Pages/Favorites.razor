@page "/favorites"
@using GitHubExplorer.Web.Components.Shared
@inject IGitHubExplorerApiClient Api
@inject ToastService Toasts
@implements IDisposable

<PageTitle>Preferiti · GitHub Explorer</PageTitle>

<h1>Preferiti</h1>

@if (favorites is { Count: > 0 })
{
    <p class="fav-count">@Preferiti(favorites.Count)</p>
}

@if (loading)
{
    <Spinner />
}
else if (error is not null)
{
    <p class="error">@error</p>
}
else if (favorites is not null)
{
    @if (favorites.Count == 0)
    {
        <div class="empty-state">
            <svg class="empty-art" width="150" height="120" viewBox="0 0 150 120" fill="none" aria-hidden="true">
                <rect x="34" y="22" width="82" height="74" rx="9" class="art-line" />
                <line x1="47" y1="44" x2="103" y2="44" class="art-soft-line" />
                <line x1="47" y1="58" x2="86" y2="58" class="art-soft-line" />
                <path d="M75 60 l5.7 11.6 12.8 1.9 -9.3 9 2.2 12.8 -11.4-6 -11.4 6 2.2-12.8 -9.3-9 12.8-1.9z" class="art-star" />
            </svg>
            <h2>Ancora nessun preferito</h2>
            <p>Vai su <a href="">Cerca</a> e salva i repository che vuoi tenere d'occhio, con una nota personale.</p>
        </div>
    }
    else
    {
        @foreach (var fav in favorites)
        {
            <RepositoryCard Owner="@fav.Owner" Name="@fav.Name" HtmlUrl="@fav.HtmlUrl"
                            Description="@fav.Description" Stars="fav.Stars"
                            Meta="@($"salvato il {fav.CreatedAt:d MMM yyyy}")">
                <div class="fav-note">
                    <textarea @bind="noteDrafts[fav.Id]" placeholder="Nota personale…"></textarea>
                    <button @onclick="() => SaveNote(fav)" disabled="@(_busy.Contains(fav.Id))">Salva nota</button>
                </div>
                <button class="danger" @onclick="() => Delete(fav)" disabled="@(_busy.Contains(fav.Id))">Elimina</button>
            </RepositoryCard>
        }
    }
}

<ConfirmDialog @ref="confirmDialog" />

@code {
    private IReadOnlyList<FavoriteDto>? favorites;
    private Dictionary<int, string?> noteDrafts = new();
    private bool loading;
    private string? error;

    private readonly CancellationTokenSource _cts = new();
    private readonly HashSet<int> _busy = new();

    private ConfirmDialog confirmDialog = default!;

    protected override async Task OnInitializedAsync() => await Load();

    private static string Preferiti(int n) => n == 1 ? "1 preferito" : $"{n} preferiti";

    private async Task Load()
    {
        loading = true; error = null;
        try
        {
            favorites = await Api.GetFavoritesAsync(_cts.Token);
            noteDrafts = favorites.ToDictionary(f => f.Id, f => f.Note);
        }
        catch
        {
            error = "Impossibile caricare i preferiti.";
            favorites = null;
        }
        finally { loading = false; }
    }

    private async Task SaveNote(FavoriteDto fav)
    {
        _busy.Add(fav.Id);
        try
        {
            var ok = await Api.UpdateNoteAsync(fav.Id, noteDrafts[fav.Id], _cts.Token);
            if (ok) Toasts.ShowSuccess("Nota salvata.");
            else { Toasts.ShowInfo("Preferito non più presente, aggiorno."); await Load(); }
        }
        catch { Toasts.ShowError("Errore nel salvataggio della nota."); }
        finally { _busy.Remove(fav.Id); }
    }

    private async Task Delete(FavoriteDto fav)
    {
        if (!await confirmDialog.ShowAsync("Rimuovi preferito", $"Vuoi rimuovere «{fav.FullName}» dai preferiti?"))
            return;

        _busy.Add(fav.Id);
        try
        {
            var ok = await Api.DeleteFavoriteAsync(fav.Id, _cts.Token);
            if (ok) Toasts.ShowSuccess($"«{fav.FullName}» rimosso.");
            else Toasts.ShowInfo("Preferito già rimosso.");
            await Load();
        }
        catch { Toasts.ShowError("Errore durante l'eliminazione."); }
        finally { _busy.Remove(fav.Id); }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}