@using GitHubExplorer.Web.Components.Shared
@inherits LayoutComponentBase

<nav class="topbar">
    <a class="brand" href="">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <span>GitHub Explorer</span>
    </a>
    <div class="nav-links">
        <NavLink href="" Match="NavLinkMatch.All">Cerca</NavLink>
        <NavLink href="favorites">Preferiti</NavLink>
    </div>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Cambia tema chiaro/scuro" title="Cambia tema">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 3 a9 9 0 0 0 0 18 Z" fill="currentColor" stroke="none" />
        </svg>
    </button>
</nav>

<main class="content">@Body</main>
<Toast />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>