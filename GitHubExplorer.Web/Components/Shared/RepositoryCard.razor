<div class="repo-card">
    <div class="repo-head">
        <img class="repo-avatar" src="@($"https://github.com/{Owner}.png?size=80")"
             alt="" loading="lazy" width="40" height="40" decoding="async" />
        <a class="repo-title" href="@HtmlUrl" target="_blank" rel="noopener noreferrer">
            <span class="repo-owner">@Owner/</span><span class="repo-name">@Name</span>
        </a>
        <span class="stars">★ @FormatStars(Stars)</span>
    </div>

    @if (!string.IsNullOrEmpty(Language) || Forks > 0 || Meta is not null)
    {
        <div class="repo-meta">
            @if (!string.IsNullOrEmpty(Language))
            {
                <span class="lang"><span class="lang-dot" style="background:@LangColor(Language)"></span>@Language</span>
            }
            @if (Forks > 0)
            {
                <span>⑂ @FormatStars(Forks)</span>
            }
            @if (Meta is not null)
            {
                <span>@Meta</span>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="desc">@Description</p>
    }
    <div class="repo-actions">@ChildContent</div>
</div>

@code {
    [Parameter, EditorRequired] public string Owner { get; set; } = "";
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public string HtmlUrl { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public int Stars { get; set; }
    [Parameter] public string? Language { get; set; }
    [Parameter] public int Forks { get; set; }
    [Parameter] public string? Meta { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static string FormatStars(int n) => n switch
    {
        >= 1_000_000 => (n / 1_000_000d).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "M",
        >= 1_000     => (n / 1_000d).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "k",
        _            => n.ToString()
    };

    private static string LangColor(string lang) => lang switch
    {
        "C#" => "#178600", "JavaScript" => "#f1e05a", "TypeScript" => "#3178c6",
        "Python" => "#3572A5", "Java" => "#b07219", "HTML" => "#e34c26",
        "CSS" => "#563d7c", "Go" => "#00ADD8", "Rust" => "#dea584", "Shell" => "#89e051",
        _ => "#8b949e"
    };
}
